# FYM frontend — copy to .env and fill in.
# All vars are baked into the JS bundle at build time (EXPO_PUBLIC_*), so
# only ever put publishable / public values here. Server secrets belong to
# backend/.env only.

# ── Supabase (required — realtime chat dies silently without it) ─────
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── API (falls back to production Render URL) ────────────────────
EXPO_PUBLIC_API_URL=https://fym-backend-tec9.onrender.com

# ── Policies & grievance officer (IT Rules 2021 / DPDP) ─────────────
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_GRIEVANCE_OFFICER=
EXPO_PUBLIC_GRIEVANCE_EMAIL=

# ── Not yet integrated (P2) ──────────────────────────────────────────
# EXPO_PUBLIC_SENTRY_DSN=
